{
  "name": "bim-resource-planner",
  "private": true,
  "version": "1.0.0",
  "description": "Cross-platform BIM team resource allocation planner (PWA for iPad, Android and Windows) with live sync via Firebase.",
  "author": "Motasem Albanna",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "cap:sync": "npx cap sync",
    "emulators": "npx firebase-tools emulators:start --only auth,firestore --project demo-bim-planner"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "date-fns": "^4.1.0",
    "docx": "^9.5.0",
    "exceljs": "^4.4.0",
    "firebase": "^12.0.0",
    "jspdf": "^3.0.0",
    "jspdf-autotable": "^5.0.0",
    "lucide-react": "^0.540.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.8.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vite-plugin-pwa": "^1.0.0"
  }
}
